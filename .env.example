# All optional. Defaults shown in comments.

# Config file. Default: ~/.config/claude-code-guardrails/config.json
# If set, the file must exist (the hook blocks otherwise).
CLAUDE_GUARDRAIL_CONFIG=/path/to/claude-code-guardrails/config.json

# JSONL event log of every block and backup. "none" disables it.
# Default: ~/.cache/claude-code-guardrails/events.jsonl
CLAUDE_GUARDRAIL_LOG=/path/to/claude-code-guardrails/events.jsonl

# Directory for untracked-file archives (created mode 0700).
# Default: ~/.cache/claude-code-guardrails/backups
CLAUDE_GUARDRAIL_BACKUP_DIR=/path/to/claude-code-guardrails/backups
